# Copy to .env.local and fill in. Next.js loads .env.local automatically;
# the test scripts (test-slay.ts, test-pipeline.ts, migrate.ts) load it too.

# Anthropic API key for the Slay Writer — https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Password for /admin and the x-admin-secret header on /api/admin/* routes
ADMIN_SECRET=your-admin-secret-here

# USDA FoodData Central — free key from https://fdc.nal.usda.gov/api-key-signup
# (DEMO_KEY works for light testing: 30 requests/hour)
USDA_API_KEY=your-usda-api-key-here
